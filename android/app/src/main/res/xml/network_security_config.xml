<?xml version="1.0" encoding="utf-8"?>
<!-- IPTV providers and TV guides are very often plain http: allowed, as on Samsung and LG. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
