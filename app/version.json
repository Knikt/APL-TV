 "body": "<!-- The video plane sits under the page: wherever the page is transparent, the picture shows -->\n    <object id=\"av\" type=\"application/avplayer\"></object>\n    <div id=\"mv\" class=\"mv\"></div>\n\n    <!-- Backdrop: dark gradient, or the artwork of what is selected -->\n    <div id=\"bg\" class=\"bg\"><div id=\"bgImgA\" class=\"bg__img\"></div><div id=\"bgImgB\" class=\"bg__img\"></div><div class=\"bg__scrim\"></div></div>\n\n    <header id=\"top\" class=\"top\">\n        <nav id=\"tabs\" class=\"tabs\"></nav>\n        <div id=\"status\" class=\"status\"><span id=\"clock\" class=\"status__clock\">09:41</span></div>\n    </header>\n\n    <main id=\"views\" class=\"views\">\n        <section id=\"v-home\" class=\"view view--home\"></section>\n        <section id=\"v-live\" class=\"view view--live\"></section>\n        <section id=\"v-guide\" class=\"view view--guide\"></section>\n        <section id=\"v-movies\" class=\"view view--vod\"></section>\n        <section id=\"v-series\" class=\"view view--vod\"></section>\n        <section id=\"v-search\" class=\"view view--search\"></section>\n        <section id=\"v-settings\" class=\"view view--settings\"></section>\n    </main>\n\n    <section id=\"detail\" class=\"detail\"></section>\n    <section id=\"person\" class=\"person\"></section>\n    <section id=\"osd\" class=\"osd\"></section>\n    <section id=\"mvui\" class=\"mvui\"></section>\n    <section id=\"sheet\" class=\"sheet\"></section>\n\n    <div id=\"menu\" class=\"menu\"><div class=\"menu__panel\"></div></div>\n    <div id=\"alert\" class=\"alert\"></div>\n    <div id=\"toast\" class=\"toast\" aria-live=\"polite\"></div>\n    <div id=\"boot\" class=\"boot\"><div class=\"boot__logo\"><span class=\"boot__mark\">APL</span><span class=\"boot__tv\">TV</span></div><div id=\"bootMsg\" class=\"boot__msg\"></div></div>\n    <input id=\"ime\" class=\"ime\" type=\"text\" autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"off\" spellcheck=\"false\">"
